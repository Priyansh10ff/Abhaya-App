# ─────────────────────────────────────────────────────
# Abhaya App — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────

# Claude API — console.anthropic.com
CLAUDE_API_KEY=your_claude_api_key_here

# Supabase — supabase.com → project → Settings → API
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Google Maps — console.cloud.google.com → Maps SDK for Android
# Also add this to app.json android.config.googleMaps.apiKey
GOOGLE_MAPS_KEY=your_google_maps_api_key_here
